# Copy to artifacts/api-server/.env on the VPS, then `chmod 600`.

# Postgres (local on the VPS)
DATABASE_URL=postgresql://automystics:CHANGE_ME_STRONG_PW@127.0.0.1:5432/automystics

# Required: long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Required in production: change the default admin password before first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PW

# Server
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
